---
import PageTitle from "@/components/ui/PageTitle.astro";
import { defaultLocale, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations(defaultLocale);
---

<Layout
	title={t("notFound.title")}
	description={t("notFound.description")}
	indexRobots={false}
>
	<PageTitle class="text-center">{t("notFound.heading")}</PageTitle>
</Layout>
