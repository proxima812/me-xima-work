---
import ProjectLink from "@/components/projects/ProjectLink.astro";
import BackLink from "@/components/ui/BackLink.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { getProjects } from "@/data/projects";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ru");
const projects = getProjects("ru");
---

<Layout
	title={t("projects.title")}
	description={t("projects.description")}
	htmlLang="ru"
	alternates={buildAlternates(Astro.url.pathname)}
>
	<div class="flex flex-col gap-3">
		<BackLink locale="ru" />

		<PageTitle>{t("projects.title")}</PageTitle>
	</div>

	<div class="flex flex-col gap-2">
		{projects.map((project) => (
			<ProjectLink
				href={project.href}
				title={project.title}
				description={project.description}
				repo={project.repo}
			/>
		))}
	</div>
</Layout>
