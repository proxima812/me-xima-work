---
import PostGrid from "@/components/blog/PostGrid.astro";
import BackLink from "@/components/ui/BackLink.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ru");
---

<Layout
	title={t("articles.title")}
	description={t("articles.description")}
	htmlLang="ru"
	alternates={buildAlternates(Astro.url.pathname)}
>
	<div class="flex flex-col gap-3">
		<BackLink locale="ru" />

		<PageTitle>{t("articles.title")}</PageTitle>
	</div>

	<PostGrid locale="ru" />
</Layout>
