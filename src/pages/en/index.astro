---
import PostGrid from "@/components/blog/PostGrid.astro";
import Hero from "@/components/home/Hero.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
	markdownURL="/en.md"
>
	<Hero locale="en" />

	<PostGrid locale="en" limit={8} />
</Layout>
