---
import { getRelativeLocaleUrl } from "astro:i18n";
import PostGrid from "@/components/blog/PostGrid.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
---

<Layout
	title={t("articles.title")}
	description={t("articles.description")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
>
	<div class="flex flex-col gap-3">
		<Breadcrumbs
			items={[
				{ label: t("nav.home"), href: getRelativeLocaleUrl("en", "") },
				{ label: t("nav.articles") },
			]}
			label={t("nav.breadcrumbs")}
		/>

		<div class="flex flex-wrap items-center justify-between gap-3">
			<PageTitle>{t("articles.title")}</PageTitle>
			<a
				href={getRelativeLocaleUrl("en", "articles/categories")}
				class="inline-flex min-h-10 items-center justify-center rounded-md border border-border bg-secondary px-3 py-1.5 text-center text-sm font-medium leading-none text-secondary-foreground transition-colors hover:bg-muted"
			>
				{t("articles.categories")}
			</a>
		</div>
	</div>

	<PostGrid locale="en" />
</Layout>
