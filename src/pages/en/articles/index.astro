---
import { getRelativeLocaleUrl } from "astro:i18n";
import PostGrid from "@/components/blog/PostGrid.astro";
import BackLink from "@/components/ui/BackLink.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
---

<Layout
	title={t("articles.title")}
	description={t("articles.description")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
>
	<div class="flex flex-col gap-3">
		<BackLink locale="en" />

		<div class="flex flex-wrap items-center justify-between gap-3">
			<PageTitle>{t("articles.title")}</PageTitle>
			<a
				href={getRelativeLocaleUrl("en", "articles/categories")}
				class="inline-flex items-center rounded-md border border-border bg-muted px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:bg-background"
			>
				{t("articles.categories")}
			</a>
		</div>
	</div>

	<PostGrid locale="en" />
</Layout>
