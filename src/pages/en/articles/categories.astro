---
import CategoriesPage from "@/components/pages/CategoriesPage.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
---

<Layout
	title={t("articleCategories.title")}
	description={t("articleCategories.description")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
>
	<CategoriesPage locale="en" />
</Layout>
