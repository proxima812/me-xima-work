---
import PostGrid from "@/components/blog/PostGrid.astro";
import Hero from "@/components/home/Hero.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ru");
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	htmlLang="ru"
	alternates={buildAlternates(Astro.url.pathname)}
	markdownURL="/index.md"
>
	<Hero locale="ru" />

	<PostGrid locale="ru" limit={8} />
</Layout>
