---
import HomePage from "@/components/pages/HomePage.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ru");
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	htmlLang="ru"
	alternates={buildAlternates(Astro.url.pathname)}
	markdownURL="/index.md"
>
	<HomePage locale="ru" />
</Layout>
