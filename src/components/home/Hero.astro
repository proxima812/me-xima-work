---
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "@/components/ui/Button.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";
import { getPosts } from "@/utils/blog";

export interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale = locale === "ru" ? "en" : "ru";

const posts = await getPosts(locale);
const [latestPost] = posts;
const badgeText = latestPost?.data.title ?? "proxima812";
const postsCount = posts.length;
---

<div class="flex flex-col items-center gap-6 py-6 text-center">
	<div class="flex flex-col items-center">
		<img
			src="/favicon.svg"
			alt="xima.work"
			width="80"
			height="80"
			class="drop-shadow-sm"
		>

		<div class="relative mt-3">
			<span
				aria-hidden="true"
				class="absolute -top-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rotate-45 rounded-[2px] bg-primary"
			></span>
			<span
				class="relative inline-flex items-center rounded-full bg-primary px-4 py-1.5 text-sm font-medium text-primary-foreground"
			>
				{badgeText}
			</span>
		</div>
	</div>

	<PageTitle class="max-w-2xl">{t("home.heading")}</PageTitle>

	<div class="flex flex-wrap items-center justify-center gap-3">
		<Button
			href={getRelativeLocaleUrl(locale, "articles")}
			class="relative overflow-visible pr-8"
		>
			{t("home.cta.articles")}
			<span
				class="absolute -top-2 -right-2 inline-flex size-7 items-center justify-center rounded-full border-2 border-background bg-primary text-xs font-bold leading-none text-primary-foreground"
				aria-label={`${postsCount}`}
			>
				{postsCount}
			</span>
		</Button>
		<Button
			href={getRelativeLocaleUrl(locale, "articles/categories")}
			variant="secondary"
		>
			{t("articles.categories")}
		</Button>
	</div>

	<a
		href={getRelativeLocaleUrl(otherLocale, "")}
		class="text-sm text-muted-foreground underline decoration-dashed underline-offset-4 transition-colors hover:text-foreground"
	>
		{t("home.switcher")}
	</a>
</div>
