---
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"img">;

const { alt = "", title, ...rest } = Astro.props;
const caption = title || alt;
---

<span class="my-2 inline-flex w-full min-w-0 flex-col gap-2">
	<img
		{...rest}
		alt={alt}
		title={title}
		loading={rest.loading ?? "lazy"}
		decoding={rest.decoding ?? "async"}
	>
	{caption && <span class="text-center text-sm text-muted-foreground">{caption}</span>}
</span>
