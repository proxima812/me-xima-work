---
import type { MarkdownHeading } from "astro";

export interface Props {
	headings: MarkdownHeading[];
	label: string;
	class?: string;
}

const { headings, label, class: className } = Astro.props;
---

<details
	open
	class:list={["group post-toc py-4 lg:sticky lg:top-8  lg:py-1 lg:pl-5", className]}
>
	<summary
		class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold lg:cursor-default [&::-webkit-details-marker]:hidden"
	>
		<span>{label}</span>
		<svg
			class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180 lg:hidden"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="m6 9 6 6 6-6"></path>
		</svg>
	</summary>

	<div class="relative mt-4 lg:mt-5">
		<span
			data-toc-rail
			aria-hidden="true"
			class="absolute -left-px top-0 h-5 w-px bg-primary transition-[height,transform] duration-500 ease-out"
		></span>
		<ol class="flex flex-col gap-2 border-l border-dashed border-border/60 pl-4">
			{
				headings.map((heading) => (
					<li class:list={[heading.depth === 3 && "pl-3"]}>
						<a
							href={`#${heading.slug}`}
							data-toc-link={heading.slug}
							class="block text-sm leading-snug text-muted-foreground transition-colors hover:text-foreground"
						>
							{heading.text}
						</a>
					</li>
				))
			}
		</ol>
	</div>
</details>

<style>
	[data-toc-link][data-active="true"] {
		color: var(--color-primary);
		font-weight: 600;
	}
</style>
