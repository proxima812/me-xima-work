---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { LocaleCode } from "@/config/types";
import { getPostSlug } from "@/utils/blog";

export interface Props {
	post: CollectionEntry<"blog">;
	locale: LocaleCode;
}

const { post, locale } = Astro.props;
const { title, description, category, pubDate, cover, coverAlt } = post.data;
const slug = getPostSlug(post);

const formattedDate = new Intl.DateTimeFormat(locale, {
	dateStyle: "medium",
}).format(pubDate);
---

<article>
	<a
		class="group flex flex-col gap-4"
		href={getRelativeLocaleUrl(locale, `articles/${slug}`)}
	>
		<Image
			src={cover}
			alt={coverAlt}
			class="aspect-video w-full rounded-lg object-cover transition-opacity group-hover:opacity-90"
		/>

		<div class="flex flex-col gap-2">
			<p
				class="flex items-center gap-2 text-sm tracking-wide text-muted-foreground uppercase"
			>
				<span>{category}</span>
				<span aria-hidden="true">&bull;</span>
				<time datetime={pubDate.toISOString()}>{formattedDate}</time>
			</p>

			<h3
				class="text-xl font-bold text-balance decoration-border underline-offset-4 group-hover:underline"
			>
				{title}
			</h3>

			<p class="line-clamp-3 text-muted-foreground">{description}</p>
		</div>
	</a>
</article>
