---
/**
 * Сетка иллюстраций. Внутри сетки картинки не растягиваются на всю ширину
 * вьюпорта - `wide-breakout` перехватывается на самой сетке, см. стили
 * `.post-gallery` в `PostArticle.astro`.
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
	images: ReadonlyArray<{ src: ImageMetadata; alt: string }>;
	/** Колонок на широком экране. На мобильном всегда одна. */
	columns?: 2 | 3;
}

const { images, columns = 2 } = Astro.props;

/*
 * Количество колонок задается здесь, а не в стилях `.post-gallery`:
 * скоупленный селектор `.post-content .post-gallery` перебил бы утилиту
 * `sm:grid-cols-2` по специфичности, и сетка осталась бы в одну колонку.
 */
const COLUMN_CLASS = {
	2: "grid-cols-1 sm:grid-cols-2",
	3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
} as const;
---

<div class:list={["post-gallery", COLUMN_CLASS[columns]]}>
	{images.map(({ src, alt }) => <Image src={src} alt={alt} />)}
</div>
