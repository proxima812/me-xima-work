---
/**
 * Каркас страницы поста. Astro здесь нужен только там, где без него никак:
 * `render()` контента MDX и подстановка компонентов в теги. Все видимые
 * части - React-компоненты.
 */
import { type CollectionEntry, render } from "astro:content";
import { config } from "main.config";
import ClosingCta from "@/components/blog/ClosingCta";
import { CodeBlockEn, CodeBlockRu } from "@/components/blog/CodeBlock";
import Comments from "@/components/blog/Comments";
import PostHeader from "@/components/blog/PostHeader";
import PostImage from "@/components/blog/PostImage";
import PostLink from "@/components/blog/PostLink";
import PostTable from "@/components/blog/PostTable";
import RelatedPosts from "@/components/blog/RelatedPosts";
import ScrollProgress from "@/components/blog/ScrollProgress";
import TableOfContents from "@/components/blog/TableOfContents";
import type { LocaleCode } from "@/config/types";
import { localeHref, useTranslations } from "@/i18n/client";
import { getPostSlug, getPosts } from "@/utils/blog";
import { toPostCard, toPostCards } from "@/utils/postCards";

export interface Props {
	post: CollectionEntry<"blog">;
	locale: LocaleCode;
}

const { post, locale } = Astro.props;
const { Content, headings } = await render(post);
const t = useTranslations(locale);
const githubUrl = "https://github.com/proxima812";
const { comments } = config.site;

const card = await toPostCard(post, locale);
const tocHeadings = headings
	.filter((heading) => heading.depth === 2 || heading.depth === 3)
	.map(({ slug, text, depth }) => ({ slug, text, depth }));
const hasTableOfContents = tocHeadings.length >= 3;

// Похожие: сначала посты с общей категорией, добиваем свежими.
const slug = getPostSlug(post);
const others = (await getPosts(locale)).filter((other) => getPostSlug(other) !== slug);
const shared = (other: (typeof others)[number]) =>
	other.data.categories.filter((id) => post.data.categories.includes(id)).length;
const related = await toPostCards(
	others.toSorted((a, b) => shared(b) - shared(a)).slice(0, 3),
	locale,
);

/** Абсолютный адрес поста - уходит в промт для ИИ-сервисов. */
const postUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const site = Astro.site ?? Astro.url;
const [firstCategory] = card.categories;
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ label: t("nav.home"), href: localeHref(locale) },
		{ label: t("nav.articles"), href: localeHref(locale, "articles") },
		...(firstCategory
			? [
					{
						label: firstCategory.label,
						href: `${localeHref(locale, "articles")}?category=${firstCategory.id}`,
					},
				]
			: []),
		{ label: card.title, href: Astro.url.pathname },
	].map((item, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: item.label,
		item: new URL(item.href, site).href,
	})),
};
---

<article>
	<PostHeader
		client:load
		locale={locale}
		post={card}
		author={t("site.author")}
		authorUrl={githubUrl}
	/>

	<div
		class="site-container mt-10 sm:mt-12 xl:grid xl:grid-cols-[1fr_minmax(0,720px)_1fr] xl:items-start xl:gap-8"
	>
		<div
			class="post-content mx-auto flex max-w-[720px] min-w-0 flex-col gap-5 wrap-anywhere select-text xl:col-start-2 xl:mx-0"
		>
			<Content
				components={{
					a: PostLink,
					img: PostImage,
					pre: locale === "en" ? CodeBlockEn : CodeBlockRu,
					table: PostTable,
				}}
			/>
		</div>

		{hasTableOfContents && (
			<aside class="hidden xl:sticky xl:top-28 xl:col-start-3 xl:block xl:w-[184px]">
				<TableOfContents client:media="(min-width: 80rem)" headings={tocHeadings} label={t("article.onThisPage")} />
			</aside>
		)}
	</div>

	{comments.enabled && (
		<div class="site-container mt-16">
			<div class="mx-auto max-w-[720px]">
				<Comments
					client:visible
					locale={locale}
					label={t("comments.label")}
					repo={comments.repo}
					repoId={comments.repoId}
					category={comments.category}
					categoryId={comments.categoryId}
				/>
			</div>
		</div>
	)}
</article>

<RelatedPosts
	client:visible
	locale={locale}
	posts={related}
	author={t("site.author")}
	heading={t("article.related")}
/>

<ClosingCta client:visible locale={locale} githubUrl={githubUrl} />

{hasTableOfContents && (
	<ScrollProgress client:media="(max-width: 79.99rem)" headings={tocHeadings} label={t("article.progress")} />
)}

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

<style>
@reference "@/styles/tailwind.css";

/*
 * Типографика статьи heroui.com/blog: ритм задает `gap-5` колонки, у абзацев
 * нет внешних отступов. Заголовки добавляют свой отступ сверху поверх gap.
 */
.post-content :global(p) {
	@apply text-base leading-7;
}

.post-content :global(h2) {
	@apply mt-7 font-heading text-2xl leading-8 font-medium tracking-[-0.01em] text-balance;
}

.post-content :global(h3) {
	@apply mt-3 font-heading text-xl leading-8 font-medium tracking-[-0.01em] text-balance;
}

.post-content :global(h4) {
	@apply mt-2 text-lg font-medium text-balance;
}

.post-content :global(:is(h5, h6)) {
	@apply text-base font-medium text-muted;
}

.post-content :global(strong) {
	@apply font-medium;
}

.post-content :global(a) {
	@apply underline decoration-foreground/25 underline-offset-[3px] transition-colors hover:decoration-foreground;
}

/*
 * Favicon перед ссылкой. Сам `a` остается инлайновым (не inline-flex),
 * иначе длинная ссылка перестает переноситься по строкам.
 */
.post-content :global(img.post-link-favicon) {
	@apply inline-block h-[18px] w-[18px] max-w-[18px] rounded-sm border-0 object-contain align-text-bottom shadow-none;
	margin-inline: 0 0.25rem;
	padding: 0;
	background: none;
}

.post-content :global(:not(pre) > code) {
	@apply rounded-[5px] border border-separator p-[3px] font-mono text-[0.8125em];
}

.post-content :global(ul) {
	@apply flex flex-col gap-2;
}

.post-content :global(ul > li) {
	@apply relative pl-5 before:absolute before:top-[11px] before:left-0 before:size-1.5 before:rounded-full before:bg-muted;
}

.post-content :global(ol) {
	@apply flex list-decimal flex-col gap-2 pl-5 marker:text-muted;
}

.post-content :global(li) {
	@apply text-base leading-7;
}

.post-content :global(li > :is(ul, ol)) {
	@apply mt-2;
}

.post-content :global(blockquote) {
	@apply flex flex-col gap-2 border-l-2 border-separator pl-4 text-muted;
}

.post-content :global(hr) {
	@apply my-4 border-separator;
}

/* Блок кода: подложка 4% черного, кнопки поверх справа сверху. */
.post-content :global(.code-block) {
	@apply relative overflow-visible rounded-xl;
	background: var(--code-bg);
}

.post-content :global(.code-block-actions) {
	@apply absolute top-2.5 right-2 z-[2] flex items-center gap-1;
}

.post-content :global(.code-block-lang) {
	@apply px-1.5 font-mono text-[11px] text-muted uppercase;
}

.post-content :global(.code-block-copy) {
	@apply inline-flex size-7 items-center justify-center rounded-3xl text-muted transition-[color,background-color,scale] hover:bg-default hover:text-foreground active:scale-[0.97];
}

.post-content :global(.code-block-open-trigger) {
	@apply inline-flex h-7 items-center gap-1 rounded-3xl px-2.5 text-xs font-medium text-muted transition-[color,background-color,scale] hover:bg-default hover:text-foreground active:scale-[0.97];
}

.post-content :global(.code-block-open) {
	@apply relative;
}

.post-content :global(.code-block-open-menu) {
	@apply absolute top-full right-0 z-10 mt-1 flex w-max min-w-48 list-none flex-col gap-0 overflow-hidden rounded-2xl border border-border bg-overlay p-1 shadow-overlay;
	animation: code-menu-in 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes code-menu-in {
	0% {
		opacity: 0;
		transform: scale(0.97) translateY(-2px);
	}
}

.post-content :global(.code-block-open-menu[hidden]) {
	display: none;
}

.post-content :global(.code-block-open-menu li) {
	@apply p-0 before:hidden;
}

.post-content :global(.code-block-open-item) {
	@apply flex w-full items-center gap-2 rounded-xl px-3 py-1.5 text-left text-sm whitespace-nowrap transition-colors hover:bg-default;
}

.post-content :global(img.code-block-icon) {
	@apply h-4 w-4 max-w-4 shrink-0 rounded-sm border-0 object-contain p-0 shadow-none;
	background: none;
}

.post-content :global(.code-block-body) {
	@apply overflow-x-auto rounded-xl py-3.5 text-[13px] leading-[1.42857];
}

.post-content :global(pre) {
	@apply w-max min-w-full pr-8 pl-[23px] font-mono;
	background: transparent !important;
}

.post-content :global(.code-block pre) {
	@apply pt-8;
}

.post-content :global(pre code) {
	@apply rounded-none border-0 bg-transparent p-0 font-mono text-[13px];
}

/* Shiki в двух темах: цвет берем из нужной переменной. */
.post-content :global(pre span) {
	color: var(--shiki-light);
}

:global(.dark) .post-content :global(pre span) {
	color: var(--shiki-dark);
}

/* Таблица: серая подложка, тело - белая «карточка» внутри. */
.post-content :global(.post-table) {
	@apply w-full max-w-full min-w-0 overflow-x-auto rounded-[20px] bg-surface-secondary px-1 pb-1;
}

.post-content :global(table) {
	@apply w-full border-separate border-spacing-0 text-left text-sm;
}

.post-content :global(th) {
	@apply px-4 py-2.5 text-xs leading-4 font-medium text-muted;
}

.post-content :global(td) {
	@apply border-b border-separator/50 bg-surface px-4 py-3 align-middle leading-5;
}

.post-content :global(tbody tr:first-child td:first-child) {
	@apply rounded-tl-2xl;
}

.post-content :global(tbody tr:first-child td:last-child) {
	@apply rounded-tr-2xl;
}

.post-content :global(tbody tr:last-child td) {
	@apply border-b-0;
}

.post-content :global(tbody tr:last-child td:first-child) {
	@apply rounded-bl-2xl;
}

.post-content :global(tbody tr:last-child td:last-child) {
	@apply rounded-br-2xl;
}

/* Картинка в тексте - в такой же рамке, как обложка. */
.post-content :global(img) {
	@apply block h-auto max-w-full rounded-[24px] bg-surface p-1 shadow-surface max-sm:rounded-[20px];
}

.post-content :global(figure) {
	@apply flex flex-col gap-2;
}

.post-content :global(figcaption) {
	@apply text-center text-sm text-balance text-muted;
}

.post-content :global(.post-gallery) {
	@apply grid min-w-0 gap-4;
}

.post-content :global(.post-gallery img) {
	@apply h-auto w-full object-contain;
}

/* Favicon в ProjectLink - маленькая иконка, а не фото: без рамки. */
.post-content :global(img.project-favicon) {
	@apply h-[18px] w-[18px] max-w-[18px] rounded-sm border-0 object-contain p-0 shadow-none;
	background: none;
}

.post-content :global(.link-preview) {
	--link-preview-width: 100%;
	--link-preview-padding-inline: 1rem;
	--link-preview-padding-block: 0.875rem;
	--link-preview-corners: 1.5rem;
	--link-preview-description-lines: 2;

	@apply overflow-hidden bg-surface text-foreground shadow-surface;
}

.post-content :global(.link-preview__title) {
	@apply text-base leading-snug font-medium no-underline;
}

.post-content :global(.link-preview__domain),
.post-content :global(.link-preview__description) {
	@apply text-sm leading-relaxed text-muted;
}

.post-content :global(.link-preview img) {
	@apply w-full max-w-full rounded-none p-0 shadow-none;
}
</style>

<script
	is:inline
	define:vars={{
		postTitle: card.title,
		postUrl,
	}}
>
/*
 * Разметка блока кода приходит с сервера (`CodeBlock.tsx`) - здесь только
 * поведение: копирование и меню «Открыть».
 */
const CHECK_ICON =
	'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';

/*
 * `prefill` - адрес, который принимает готовый промт параметром `q`.
 * У Gemini и Claude Code такого параметра нет: туда открываем голую страницу,
 * а промт кладем в буфер обмена.
 */
const OPEN_TARGETS = {
	chatgpt: { url: "https://chatgpt.com/", prefill: "https://chatgpt.com/?q=" },
	claude: { url: "https://claude.ai/new", prefill: "https://claude.ai/new?q=" },
	"claude-code": { url: "https://claude.ai/code", prefill: null },
	t3chat: { url: "https://t3.chat/", prefill: "https://t3.chat/new?q=" },
	gemini: { url: "https://gemini.google.com/", prefill: null },
	perplexity: {
		url: "https://www.perplexity.ai/",
		prefill: "https://www.perplexity.ai/search?q=",
	},
};

/* Длинный `q` режется прокси и самими сервисами - тогда падаем на буфер. */
const MAX_URL_LENGTH = 6000;

/* Промт всегда на английском: он адресован ИИ-сервису, а не читателю. */
function buildPrompt(code, language) {
	return [
		`I'm reading the article "${postTitle}" at ${postUrl}.`,
		"",
		"Explain the code snippet below from that article: what it does, how it",
		"works step by step, and anything worth watching out for.",
		"",
		`\`\`\`${language ?? ""}`,
		code,
		"```",
	].join("\n");
}

function openInService(code, target, language) {
	if (target === "browser") {
		const blob = new Blob([code], { type: "text/plain;charset=utf-8" });
		window.open(URL.createObjectURL(blob), "_blank", "noopener,noreferrer");
		return;
	}

	const service = OPEN_TARGETS[target];
	if (!service) return;

	const prompt = buildPrompt(code, language);
	const prefilled = service.prefill
		? service.prefill + encodeURIComponent(prompt)
		: null;
	const href =
		prefilled && prefilled.length <= MAX_URL_LENGTH ? prefilled : service.url;

	// Буфер - запасной путь: если сервис проигнорировал `q`, промт под рукой.
	navigator.clipboard
		.writeText(prompt)
		.catch(() => {})
		.finally(() => {
			window.open(href, "_blank", "noopener,noreferrer");
		});
}

function closeAllMenus(except) {
	document.querySelectorAll(".code-block-open-menu").forEach((menu) => {
		if (menu === except) return;
		menu.hidden = true;
		menu.previousElementSibling?.setAttribute("aria-expanded", "false");
	});
}

document.addEventListener("click", (event) => {
	if (event.target.closest(".code-block-open")) return;
	closeAllMenus();
});

document.addEventListener("keydown", (event) => {
	if (event.key === "Escape") closeAllMenus();
});

document.querySelectorAll(".post-content .code-block").forEach((block) => {
	const code = block.querySelector("pre code");
	const codeText = () => code?.textContent ?? "";

	const copyButton = block.querySelector(".code-block-copy");
	const copyIcon = copyButton?.innerHTML;
	const copyLabel = copyButton?.getAttribute("aria-label");
	copyButton?.addEventListener("click", () => {
		navigator.clipboard
			.writeText(codeText())
			.then(() => {
				copyButton.innerHTML = CHECK_ICON;
				copyButton.setAttribute("aria-label", copyButton.dataset.copiedLabel);
				setTimeout(() => {
					copyButton.innerHTML = copyIcon;
					copyButton.setAttribute("aria-label", copyLabel);
				}, 2000);
			})
			.catch(() => {});
	});

	const trigger = block.querySelector(".code-block-open-trigger");
	const menu = block.querySelector(".code-block-open-menu");
	if (!trigger || !menu) return;

	trigger.addEventListener("click", (event) => {
		event.stopPropagation();
		const isHidden = menu.hidden;
		closeAllMenus(isHidden ? menu : undefined);
		menu.hidden = !isHidden;
		trigger.setAttribute("aria-expanded", String(isHidden));
	});

	const language = block.querySelector("pre")?.dataset.language;

	menu.querySelectorAll("[data-target]").forEach((button) => {
		button.addEventListener("click", () => {
			openInService(codeText(), button.dataset.target, language);
			menu.hidden = true;
			trigger.setAttribute("aria-expanded", "false");
		});
	});
});
</script>
