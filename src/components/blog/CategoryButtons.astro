---
import type { LocaleCode } from "@/config/types";
import { getCategoryStats } from "@/utils/blog";

export interface Props {
	locale: LocaleCode;
	countLabel: string;
}

const { locale, countLabel } = Astro.props;
const stats = await getCategoryStats(locale);
---

<div class="grid border-t border-border sm:grid-cols-2">
	{
		stats.map(({ category, count }) => (
			<div class="flex min-h-16 items-center justify-between gap-4 border-b border-border py-3 sm:odd:pr-6 sm:even:border-l sm:even:pl-6">
				<div class="flex min-w-0 items-center gap-3">
					<img
						src={category.icon}
						alt=""
						class="size-6 shrink-0 object-contain"
						loading="lazy"
						decoding="async"
					/>
					<span class="truncate font-medium leading-none text-foreground">
						{category.label[locale]}
					</span>
				</div>
				<span class="shrink-0 text-sm text-muted-foreground">
					{count} {countLabel}
				</span>
			</div>
		))
	}
</div>
