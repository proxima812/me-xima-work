---
import BlogHeading from "@/components/blog/BlogHeading";
import CategoryGrid from "@/components/blog/CategoryGrid";
import ClosingCta from "@/components/blog/ClosingCta";
import type { LocaleCode } from "@/config/types";
import { localeHref, useTranslations } from "@/i18n/client";
import { getCategoryStats } from "@/utils/blog";

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const categories = (await getCategoryStats(locale))
	.toSorted((a, b) => b.count - a.count)
	.map(({ category, count }) => ({
		id: category.id,
		label: category.label[locale] ?? category.id,
		icon: category.icon,
		count,
		href: `${localeHref(locale, "articles")}?category=${category.id}`,
	}));
---

<div class="site-container pt-8 sm:pt-[72px]">
	<BlogHeading
		eyebrow={t("nav.categories")}
		top={t("articleCategories.title")}
		bottom={t("articleCategories.description")}
	/>
	<CategoryGrid client:load categories={categories} countLabel={t("articleCategories.count")} />
</div>

<ClosingCta client:visible locale={locale} githubUrl="https://github.com/proxima812" />
