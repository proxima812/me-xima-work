---
/**
 * Ссылка «назад» над заголовком страницы. Подчеркнута и со стрелкой -
 * чтобы читалась как управляющий элемент, а не как часть текста.
 * Цветом не выделяется: в палитре нет «ссылочного синего».
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

export interface Props {
	locale: LocaleCode;
	/** Куда вести. По умолчанию - главная текущей локали. */
	href?: string;
	/** Свой текст вместо «На главную». */
	label?: string;
}

const { locale, href, label } = Astro.props;

const t = useTranslations(locale);
---

<a
	href={href ?? getRelativeLocaleUrl(locale, "")}
	class="inline-flex w-fit items-center gap-1.5 text-sm font-medium text-muted-foreground underline decoration-border underline-offset-4 transition-colors select-none hover:text-foreground hover:decoration-foreground"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		width="14"
		height="14"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M19 12H5"></path>
		<path d="m12 19-7-7 7-7"></path>
	</svg>
	{label ?? t("nav.back")}
</a>
