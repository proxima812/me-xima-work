---
/**
 * Строка проекта: favicon домена, название-ссылка, описание и, если основная
 * ссылка ведет на сайт, отдельная маленькая ссылка на исходники.
 */
import { getLocaleFromUrl, useTranslations } from "@/i18n";

export interface Props {
	href: string;
	title: string;
	description: string;
	/** `| undefined` обязателен: в проекте включен `exactOptionalPropertyTypes`. */
	repo?: string | undefined;
}

const { href, title, description, repo } = Astro.props;

const t = useTranslations(getLocaleFromUrl(Astro.url));
const faviconSrc = `https://www.google.com/s2/favicons?sz=64&domain=${new URL(href).hostname}`;
---

<div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 select-text">
	<img
		src={faviconSrc}
		alt=""
		width="18"
		height="18"
		loading="lazy"
		class="project-favicon h-[18px] w-[18px] shrink-0 rounded-sm"
	>
	<a
		href={href}
		target="_blank"
		rel="noreferrer"
		class="font-medium text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground"
	>
		{title}
	</a>
	<span class="text-muted-foreground">{description}</span>
	{repo && (
		<a
			href={repo}
			target="_blank"
			rel="noreferrer"
			class="text-sm text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
		>
			{t("projects.code")}
		</a>
	)}
</div>
