# Заголовки для Cloudflare Pages. Файл копируется в dist как есть.
# Отступ в два пробела обязателен: без него строка не считается заголовком.
#
# Cloudflare применяет ВСЕ подходящие правила и склеивает одноименные
# заголовки через запятую. Поэтому Cache-Control задается ровно один раз на
# путь: правило `/*` с кешем сломало бы `/_astro/*`, склеив два значения.
#
# HTML тут не описан намеренно: Pages по умолчанию отдает его с
# `max-age=0, must-revalidate`, а это ровно то, что нужно.

# Ассеты с хешем в имени: содержимое меняется вместе с именем файла,
# поэтому кеш навсегда и без перепроверки. Шрифты лежат здесь же.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Иконки и og-картинка: имя стабильное, меняются редко.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-16x16.png
  Cache-Control: public, max-age=604800
/favicon-32x32.png
  Cache-Control: public, max-age=604800
/favicon-48x48.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/512x512.png
  Cache-Control: public, max-age=604800
/default-ogImage.jpg
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400

# Служебные файлы: их читают роботы, обновляться должны быстро.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600

# Markdown-двойники страниц.
/index.md
  Cache-Control: public, max-age=3600
/en.md
  Cache-Control: public, max-age=3600

# Общее для всех ответов. Cache-Control здесь нет специально.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
